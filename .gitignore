__pycache__/
*.pyc
.venv/
venv/

# Release artifacts and signing
*.apk
*.aab
*.jks
*.keystore
keystore.properties

# Test-set manifests copy labels from third-party datasets (some non-commercial / unlicensed):
# regenerate locally with tools/food-bench/datasets.py (fixed seed) instead of committing them.
tools/food-bench/results/*/manifests/
